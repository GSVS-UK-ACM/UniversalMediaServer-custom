<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://gsvs.local/ums-tv-client" version="0.1.0" viewmodes="maximized">
  <tizen:application id="GSVSUMSTVC.TVClient" package="GSVSUMSTVC" required_version="5.5" />
  <name>UMS TV Client</name>
  <content src="index.html" />
  <icon src="icon.png" />
  <access origin="*" subdomains="true" />
  <tizen:profile name="tv-samsung" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable" />
  <tizen:metadata key="http://samsung.com/tv/metadata/screen.size" value="normal" />
  <tizen:content-security-policy>default-src 'self'; script-src 'self' $WEBAPIS; style-src 'self'; connect-src http: https:; img-src 'self' http: https: data:; media-src http: https: blob:; object-src 'self'</tizen:content-security-policy>
</widget>
