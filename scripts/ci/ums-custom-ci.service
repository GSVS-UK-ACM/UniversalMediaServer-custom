[Unit]
Description=UMS custom GitHub Actions runner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runner-ums
Environment=JAVA_HOME=%h/.local/share/ums-ci/jdk
Environment=PATH=%h/.local/share/ums-ci/bin:%h/.local/share/ums-ci/jdk/bin:%h/.local/share/ums-ci/apache-maven-3.9.16/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=%h/.local/share/ums-ci/native/usr/lib/x86_64-linux-gnu
ExecStart=%h/actions-runner-ums/run.sh
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=300

[Install]
WantedBy=default.target
